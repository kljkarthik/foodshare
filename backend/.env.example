# Environment Variables Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control

# Server Configuration
NODE_ENV=development
PORT=3000

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name
# Get this from MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority

# JWT Secret for token signing
# Generate a strong random string (minimum 32 characters)
# Example: Use `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Database Configuration (optional)
DB_NAME=food-share

# API Configuration (optional)
API_TIMEOUT=30000

# Logging Level (optional)
LOG_LEVEL=debug
